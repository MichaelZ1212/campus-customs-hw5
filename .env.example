# Copy to .env (never commit .env) or export these in your shell.
# backend/config.py loads .env automatically; real shell variables take precedence.

# Required: Portkey gateway key. Every agent calls gpt-6-luna through Portkey with it.
PORTKEY_API_KEY=replace-with-your-portkey-key

# Optional: frontend API base URL (put this in frontend/.env.local if the backend isn't on :8000)
# VITE_API_URL=http://localhost:8000
