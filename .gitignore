# Secrets: never commit real credentials (use .env.example as the template)
.env
.env.*
!.env.example
*.key
*API*Key*.txt

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend dependencies and build output (reinstall with `npm install`)
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# SQLite side files (the .db files themselves ARE committed)
*.db-wal
*.db-shm
*.db-journal
!data/campus_customs.db
!data/campus_customs_new.db

# Temporary / editor / OS files
output/*.tmp
*.json.tmp
.claude/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
